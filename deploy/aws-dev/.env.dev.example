# Copy to <repo root>/.env.dev ON THE EC2 INSTANCE (never commit the real file).
ENV=production            # required: turns on Secure + SameSite=None refresh cookie (HTTPS)
API_DOCS_ENABLED=true

# DB (container "postgres"; host/port/ssl are forced in the compose file)
DB_USER=blueprint
DB_PASSWORD=CHANGE_ME_long_random
DB_NAME=blueprint_dev

SUPER_ADMIN_EMAIL=you@example.com

JWT_SECRET=CHANGE_ME_openssl_rand_base64_32
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=720h
GOOGLE_CLIENT_ID=

# Cloudflare R2 - use a SEPARATE dev bucket
USE_S3=true
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=blueprint-audio-assets-dev
S3_USE_SSL=true
S3_REGION=auto
S3_PUBLIC_ENDPOINT=

# Payments: TEST keys only
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_WEBHOOK_KEY=
INR_USD_RATE=0.012

# Frontend origin(s): exact, https, no trailing slash
APP_BASE_URL=https://dev.waveyard.studio
ALLOWED_ORIGINS=https://dev.waveyard.studio

EMAIL_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_AUTHENTICATED=1000

WORKER_POLL_INTERVAL=2s
WORKER_LEASE_DURATION=30m

# Used by compose + the "server is up" Telegram ping
CLOUDFLARE_TUNNEL_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DEV_API_URL=https://api-dev.waveyard.studio
