        {
          "editorMode": "code",
          "expr": "100 - (100 * (sum(rate(http_requests_total{job=~\"$job\",instance=~\"$instance\",method=~\"$method\",path=~\"$path\",status=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_requests_total{job=~\"$job\",instance=~\"$instance\",method=~\"$method\",path=~\"$path\"}[5m])) or vector(0), 0.000001))",
          "instant": true,
