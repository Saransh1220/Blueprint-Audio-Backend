# Environment Configuration Template
# Copy this file to .env and update with your actual values

# Server
PORT=8080
ENV=development
# Set false to hide /docs and /openapi.* in restricted production environments.
API_DOCS_ENABLED=true

# Database
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blueprint-audio
DB_SSLMODE=disable

# Migrations
# Set AUTO_MIGRATE=true on Render so migrations run before the server starts.
AUTO_MIGRATE=false
MIGRATIONS_PATH=db/migrations
SUPER_ADMIN_EMAIL=

# JWT
JWT_SECRET=your-secret-key-here-generate-with-openssl
JWT_EXPIRATION=24h

# Cloudflare R2 (Used for dev + production)
# Get credentials from: https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens
USE_S3=true
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Browser-reachable S3 API endpoint used to sign direct PUT and private GET URLs.
# Leave blank to use S3_ENDPOINT. Do not set this to an R2 custom CDN domain.
S3_PRESIGN_ENDPOINT=
S3_ACCESS_KEY=your-r2-access-key
S3_SECRET_KEY=your-r2-secret-key
S3_BUCKET=blueprint-audio-assets
S3_USE_SSL=true
S3_REGION=auto
S3_PUBLIC_ENDPOINT=

# Razorpay (Test credentials for development)
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_secret_key

# Razorpay (Production credentials)
# RAZORPAY_KEY_ID=rzp_live_your_key_id
# RAZORPAY_KEY_SECRET=your_live_secret_key

# Global USD checkout (Dodo Payments)
# India users pay INR through Razorpay. Non-India users pay USD through Dodo.
# Get API keys/webhook secret from your Dodo Payments dashboard.
DODO_PAYMENTS_API_KEY=dodo_test_your_api_key
DODO_PAYMENTS_PRODUCT_ID=pdt_your_checkout_product_id
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_webhook_secret
# Optional. Leave blank/default for production unless Dodo gives a different base URL.
DODO_PAYMENTS_API_URL=

# Currency display/pricing
# Used only as a fallback to suggest USD display/checkout prices from INR catalog prices.
# Example: 1 INR ~= 0.012 USD. Prefer updating stored USD prices after generation.
INR_USD_RATE=0.012

# Redis
# Set REDIS_ENABLED=false in production if you do not want to run/pay for Redis.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# App links used inside emails
APP_BASE_URL=http://localhost:4200

# Email (Resend)
# Get from: https://resend.com/api-keys
EMAIL_ENABLED=true
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="Blueprint <noreply@example.com>"
EMAIL_REPLY_TO=

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4000

# Rate Limiting
RATE_LIMIT_ANONYMOUS=100
RATE_LIMIT_AUTHENTICATED=1000

GOOGLE_CLIENT_ID=
# JWT Refresh Token Expiration
# Use short values like 30s for testing, 720h (30 days) for production
JWT_REFRESH_EXPIRATION=720h

# Durable media worker (embedded in API server or run as standalone worker)
WORKER_ENABLED=true
WORKER_ID=local-worker
WORKER_POLL_INTERVAL=2s
WORKER_LEASE_DURATION=30m
